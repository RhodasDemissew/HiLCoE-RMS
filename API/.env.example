# ============================================
# HiLCoE RMS Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# MongoDB Connection (REQUIRED)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hilcoe_rms?retryWrites=true&w=majority

# JWT Secret (REQUIRED - Generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-random-string

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Configuration
CORS_ORIGIN=*

# Frontend Base URL
APP_BASE_URL=https://your-frontend.vercel.app

# Format Checker Service URL
FORMAT_CHECKER_URL=https://your-checker.onrender.com

# File Storage Directory
STORAGE_DIR=./storage
